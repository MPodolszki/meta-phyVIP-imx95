/*
 * Device Tree Overlay: ITE IT6263 LVDS-to-HDMI bridge
 * Target board: imx95-phyflex-libra-rdk-2
 *
 * To enable at boot, add this line to overlays.txt:
 *   fdt_overlays=imx95-phyflex-libra-rdk-2-it6263-hdmi.dtbo
 */
 
#include "imx95-pinfunc.h"
#include "imx95-clock.h"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/dts-v1/;
/plugin/;

&scmi_iomuxc {
	pinctrl_hdmi_en: hdmiengrp {
		fsl,pins = <
			IMX95_PAD_XSPI1_DQS__GPIO5_IO_BIT8 0x31e
		>;
	};
};

/* GPIO5 Bit 8 dauerhaft high → HDMI_EN am HDMI2C4-5F2 → 5V + HPD aktiv */
&gpio5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hdmi_en>;

	hdmi-en-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "hdmi-en";
	};
};

&lpi2c3 {

	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	it6263: hdmi-bridge@4c {
		compatible = "ite,it6263";
		reg = <0x4c>;
        status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* Input: LVDS from LDB channel@1 (LVDS2 pins) */
			port@0 {
				reg = <0>;
				it6263_in: endpoint {
					remote-endpoint = <&lvds2_out>;
				};
			};

			/* Output: HDMI sink */
			port@1 {
				reg = <1>;
				it6263_out: endpoint {
					/* Leave open — IT6263 drives HDMI directly */
				};
			};
		};
	};
};



/*
 * Display pipeline (same as imx95-phyflex-libra-rdk-lvds.dtsi):
 *   DPU → pixel_interleaver → display_pixel_link → LDB → IT6263 → HDMI
 */
&display_pixel_link {
	status = "okay";
};

&displaymix_irqsteer {
	status = "okay";
};

&dpu {
	status = "okay";
};

&ldb {
	#address-cells = <1>;
	#size-cells = <0>;
	/*
	 * LDBPLL for 1920x1080@60: pixel clock = 148.5 MHz
	 * ldb_pll_div7 = LDBPLL / 7 → 1039.5 MHz / 7 = 148.5 MHz (exact)
	 * LDBPLL_VCO = 1039.5 MHz * 3 = 3118.5 MHz  (RDIV=3)
	 * disp1pix (clk_pix) takes ldb_pll_pixel (=ldb_pll_div7) automatically
	 */
	assigned-clocks = <&scmi_clk IMX95_CLK_LDBPLL_VCO>,
			  <&scmi_clk IMX95_CLK_LDBPLL>;
	assigned-clock-rates = <3118500000>, <1039500000>;
	status = "okay";

	channel@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		reg = <1>;

		port@1 {
			reg = <1>;
			lvds2_out: endpoint {
				remote-endpoint = <&it6263_in>;
			};
		};
	};
};

&ldb1_phy {
	status = "okay";
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@1 {
		reg = <1>;
		status = "okay";
	};
};
