/*
 * Copyright 2026 PHYTEC Messtechnik GmbH
 *
 * PHYTEC phyVIP carrier (PV-05832-001-1645-0-004) with phyFLEX-i.MX95 FPSC.
 *
 * The phyVIP and the Libra RDK use the same SoM, so this board is described as
 * a delta on top of the RDK device tree rather than as a copy of it. Everything
 * SoM-side is inherited unchanged; what differs is the carrier.
 *
 * The one structural difference is that the phyVIP has NO I2C GPIO expanders.
 * The RDK fits two ti,tcal6416 at 0x21 and hangs a fair amount of board control
 * off them; on phyVIP neither responds, verified on hardware:
 *
 *   i2cdetect -y -r 2   ->  0x21 absent   (426b0000.i2c, gpio_expander1)
 *   i2cdetect -y -r 3   ->  0x21 absent   (42530000.i2c, gpio_expander2)
 *
 * Left as-is, both nodes fail to probe and fw_devlink parks every consumer in
 * permanent deferred probe -- including 4c300000.pcie, which is the root
 * complex the Kinara Ara-2 sits behind (schematic sheets 21-23). That is why
 * the accelerator did not appear in lspci at all: not a driver or firmware
 * problem, the controller simply never came up.
 *
 * sfp, panel-lvds0, backlight and oscillator-mclk-gated also reference the
 * expanders, but they are already disabled in the RDK device tree, so their
 * references are harmless and are deliberately left in place.
 */

/dts-v1/;

#include "imx95-phyflex-libra-rdk.dts"

/ {
	/*
	 * The RDK compatible is kept in the list on purpose: U-Boot and the
	 * bootloader-side fixups match on it, and the SoM half of the board is
	 * genuinely identical.
	 */
	compatible = "phytec,imx95-phyflex-phyvip",
		     "phytec,imx95-phyflex-libra-rdk",
		     "phytec,imx95-phyflex-fpsc-g", "fsl,imx95";
	model = "PHYTEC phyVIP phyFLEX-i.MX95 FPSC";
};

/* Not populated on this carrier. */
&gpio_expander1 {
	status = "disabled";
};

&gpio_expander2 {
	status = "disabled";
};

/*
 * PCIE1_nWAKE / PCIE2_nWAKE have no net on phyVIP. Only the wake line comes
 * from an expander -- PCIE1_nPERST is a SoC pin (gpio1[10], net X_PCIE1_nPERST,
 * schematic sheet 23) and stays as the RDK has it.
 *
 * These two properties are what actually blocked the Kinara Ara-2: dw-pcie
 * calls gpiod_get_optional() for them, which returns -EPROBE_DEFER rather than
 * NULL while the gpiochip is missing, so disabling the expander above is not by
 * itself enough.
 */
&pcie0 {
	/delete-property/ wake-gpios;
};

&pcie1 {
	/delete-property/ wake-gpios;
};

/*
 * CAN1_STBY / CAN2_STBY are expander lines on the RDK with no phyVIP
 * equivalent. standby-gpios is optional for phy-can-transceiver, so dropping it
 * leaves both transceivers permanently active, which is the correct behaviour
 * here -- they are not software-controllable on this carrier.
 */
&can_transceiver1 {
	/delete-property/ standby-gpios;
};

&can_transceiver2 {
	/delete-property/ standby-gpios;
};

/* HD3SS3220 USB-C controller: not fitted (i2cdetect: 0x47 absent on i2c-3). */
&{/soc/bus@42000000/i2c@42530000/usb-typec@47} {
	status = "disabled";
};

/*
 * The RV3028 is present, but the RDK routes its nINT to gpio_expander2.
 * i2c_device_probe() resolves the IRQ through of_irq_get(), which returns
 * -EPROBE_DEFER while the interrupt controller is missing, so the interrupt has
 * to go explicitly or the RTC never probes. Alarm and wakeup are unavailable
 * until the phyVIP routing for RTC_INT is confirmed -- gpio2[18] carries that
 * name in the SoM gpio-line-names and is the likely candidate.
 */
&rv3028 {
	/delete-property/ interrupt-parent;
	/delete-property/ interrupts;
	/delete-property/ wakeup-source;
};

/*
 * WLAN/Bluetooth -- BDE-BW3351UP1 (TI CC33xx), schematic sheet "WLAN/Bluetooth",
 * designator U14. This is the largest carrier difference after the missing GPIO
 * expanders, and it is NOT what the RDK fits: the Libra RDK carries an NXP
 * IW612/88W8987 that the out-of-tree nxp-wlan module claims by SDIO ID alone,
 * with no device tree child at all.
 *
 * Modelled on PHYTEC's own working reference for the same chip family,
 * k3-am625-phyverso-evcs-cc3351.dtso in linux-phytec-ti (v6.12.49-11.02.02-phy).
 * Deviations from it are called out below.
 *
 * Signal routing taken from the schematic and resolved against the FPSC pinout
 * in imx95-phyflex-fpsc-g-som.dtsi:
 *
 *   SDIO      X_SD2_CLK/CMD/D0..D3 via R97..R102 (0R)  ->  FPSC SDIO = usdhc3
 *   UART      X_UART2_RXD/TXD/RTS/CTS                  ->  FPSC UART2 = lpuart5
 *   IRQ_WL    module pin 14, jumper J18 -> X_GPIO4     ->  gpio2[17] ("GPIO4")
 *   IRQ_BLE   module pin  2, jumper J19 -> X_GPIO3     ->  gpio1[12] ("GPIO3")
 *   nRESET    module pin 40 <- X_nRESET_OUT_1V8        ->  board reset, no GPIO
 *
 * Assembly, from the schematic's own stuffing convention -- sheet 1 states
 * "Parts with property 'nm' are not mounted on PCB", and the WLAN/Bluetooth
 * sheet carries no 'nm' at all (the marker does appear on 11 other sheets, so
 * its absence here is meaningful): R97..R102, J18, J19 and U14 are all fitted.
 *
 * J18/J19 are 3-pin jumpers that steer the two SoM lines between the module
 * and the CON1 expansion connector:
 *
 *   pin 1  ->  module IRQ (IRQ_WL on J18, IRQ_BLE on J19)
 *   pin 2  ->  X_GPIO4 / X_GPIO3 from the SoM
 *   pin 3  ->  GPIO4 / GPIO3 to the expansion connector (sheet 13, zone B1)
 *
 * Both are annotated 1+2, i.e. SoM line tied to the module interrupt, which is
 * what this device tree assumes. The convention was cross-checked against
 * J16/J17 on sheet 11, where the same kind of setting string next to the
 * designator ("2+3") is spelled out in prose as the populated configuration.
 * Inferred from the drawing, not from an assembly variant table -- if WLAN
 * probes but never takes an interrupt, J18 is still the first thing to meter.
 */

/ {
	/*
	 * btti_uart_probe() calls devm_regulator_get_optional(dev, "cc33xx")
	 * and bails out on any error, -ENODEV included -- despite the name,
	 * the supply is mandatory or Bluetooth does not probe at all. phyVIP
	 * has no software power switch for the module (VCC_3V3 and VCC_1V8 are
	 * always on, nRESET comes from the board reset), so this is a fixed
	 * always-on regulator, exactly as on the phyVERSO EVCS.
	 */
	reg_wifi: regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "WIFI_EN";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&usdhc3 {
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * Mandatory for the CC33xx, measured on the board 2026-09-03:
	 * cc33xx_sdio_power_on() calls pm_runtime_get_sync(&card->dev), but the
	 * mmc core only calls pm_runtime_enable() on that device inside an
	 * "if (host->caps & MMC_CAP_POWER_OFF_CARD)" (drivers/mmc/core/sdio.c).
	 * Without the cap, runtime PM stays disabled and get_sync returns
	 * -EACCES, which the driver reports as
	 *   cc33xx_sdio_power_on: failed to get_sync(-13)
	 *   cc33xx: ERROR FW download failed
	 * and no wlan interface ever appears. mmc_of_parse() in
	 * drivers/mmc/core/host.c turns exactly this property into that cap.
	 */
	cap-power-off-card;

	/*
	 * SDIO function 2, as on the phyVERSO EVCS -- the CC33xx puts WLAN on
	 * function 2, and the mmc core matches this node to the function by
	 * reg. With reg = <1> the node would never attach and
	 * cc33xx_probe_of() would return -ENODEV.
	 *
	 * compatible is "ti,cc3300" and not the reference's "ti,cc3301":
	 * cc33xx_sdio_of_match_table[] in the SDK 1.0.2.10 driver this layer
	 * forward-ports to 6.18 carries the single entry "ti,cc3300". The
	 * reference targets the older 6.12 TI tree.
	 *
	 * Only interrupt index 0 is given. cc33xx_probe_of() reads index 0 as
	 * the data interrupt and index 1 as a wake interrupt; IRQ_BLE belongs
	 * to the Bluetooth side and is wired there as host-wakeup-gpios.
	 */
	cc33xx: wifi@2 {
		compatible = "ti,cc3300";
		reg = <2>;
		interrupt-parent = <&gpio2>;
		interrupts = <17 IRQ_TYPE_EDGE_RISING>;
	};
};

/*
 * FPSC UART2. The RDK puts Bluetooth on lpuart8 (FPSC UART1, shared with
 * RS232/RS485) -- on phyVIP the module's UART goes to UART2 instead, so
 * imx95-phyflex-libra-rdk-bluetooth-88w8987.dtbo does not apply to this board
 * even though the machine still builds it as an available overlay.
 *
 * max-speed matches the phyVERSO reference. IRQ_BLE goes in as
 * host-wakeup-gpios, not as "interrupts": btti_uart_host_wake_init() looks the
 * line up with devm_gpiod_get_optional(dev, "host-wakeup") and ignores any
 * interrupts property. This one really is optional.
 */
&lpuart5 {
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_wifi>;
		host-wakeup-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		max-speed = <115200>;
	};
};
